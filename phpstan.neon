parameters:
    level: 9
    paths:
        - src
        - app
        - provider
        - database
    excludePaths:
        - app/*/View/*
    ignoreErrors:
        # env.php is a runtime file (gitignored), absent in a fresh clone
        - identifier: include.fileNotFound
          path: src/functions.php
    bootstrapFiles:
        - bootstrap/app.php
    tmpDir: %currentWorkingDirectory%/.phpstan
